# Copy to .env and fill in. .env is ignored by git.
JENKINS_ADMIN_PASSWORD=
XO_TOKEN=
# The controller's own root URL, as the pool's guests reach it.
CONTROLLER_URL=http://controller.example:8080/
XO_URL=https://xo.example
# SHA-256 of the XO certificate, colon-separated. Leave empty for a CA-signed certificate.
XO_FINGERPRINT=
TEMPLATE_NAME=jenkins-agent-debian13
# Directory holding the plugin build to run, as xcpng-cloud.hpi. Defaults to ./plugin.
XCPNG_CLOUD_PLUGIN_DIR=
