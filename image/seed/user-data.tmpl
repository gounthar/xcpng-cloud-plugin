#cloud-config
#
# Per-clone seed. NOT the image build recipe: everything durable (Temurin 21, guest tools) is
# already on the golden image via image/provision.sh. This carries only what differs per agent,
# which is the controller URL, the agent name, and the JNLP secret.
#
# Rendered by the plugin at provision time. Placeholders:
#   {{INSTANCE_ID}}    the VM's XAPI UUID. See meta-data.tmpl and the warning below.
#   {{JENKINS_URL}}    e.g. https://ci.example.com/jenkins/
#   {{AGENT_NAME}}     the Jenkins node name
#   {{AGENT_SECRET}}   the node's JNLP secret
#
# The NoCloud seed the plugin will assemble at M3 is three files: this user-data, meta-data (the
# unique instance-id), and a static network-config (DHCP on ethernet interfaces, matched by name
# glob `e*`). The network-config is not optional for a from-scratch `import_raw_vdi` bootstrap:
# without it a fresh disk boots with no network and the agent can never reach the controller. A
# clone of the golden image already carries a working network config on disk. None of this is wired
# up yet (see below); the three files exist as proven M3 groundwork.
#
# The secret reaches the guest through a NoCloud seed on a CD, which means it is readable by
# anything that can attach that VDI. Ephemeral agents make this tolerable; a warm pool would not.
#
# NOT YET WIRED UP. This is M3 groundwork. M2 was performed by hand, on purpose.

write_files:
  # Owned by debian directly at 0400: the service runs as debian and only reads it. This is why
  # there is no setfacl below and no acl package: cloud-init creates the user before write_files.
  - path: /etc/jenkins-agent.secret
    permissions: '0400'
    owner: debian:debian
    content: "{{AGENT_SECRET}}"

  - path: /etc/systemd/system/jenkins-agent.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Jenkins inbound agent
      After=network-online.target
      Wants=network-online.target

      [Service]
      User=debian
      WorkingDirectory=/home/debian/agent
      # Only fetch agent.jar when it is missing or empty. With Restart=on-failure/RestartSec=5, an
      # unconditional download would hammer the controller in a tight loop while the agent flaps.
      ExecStartPre=/bin/sh -c 'test -s /home/debian/agent/agent.jar || curl -sSfL -o /home/debian/agent/agent.jar {{JENKINS_URL}}jnlpJars/agent.jar'
      # -webSocket tunnels the agent connection over the controller's HTTP port, so no separate
      # inbound JNLP TCP port has to be opened or forwarded.
      # -secret @file keeps the secret out of /proc/*/cmdline.
      ExecStart=/usr/bin/java -jar /home/debian/agent/agent.jar \
        -webSocket \
        -url {{JENKINS_URL}} \
        -secret @/etc/jenkins-agent.secret \
        -name {{AGENT_NAME}} \
        -workDir /home/debian/agent
      Restart=on-failure
      RestartSec=5

      [Install]
      WantedBy=multi-user.target

runcmd:
  - [ install, -d, -o, debian, -g, debian, -m, '0700', /home/debian/agent ]
  - [ systemctl, daemon-reload ]
  - [ systemctl, enable, --now, jenkins-agent.service ]
