<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jenkins-ci.plugins</groupId>
    <artifactId>plugin</artifactId>
    <version>6.2211.v27f680c93c53</version>
    <relativePath />
  </parent>

  <groupId>io.jenkins.plugins</groupId>
  <artifactId>xcpng-cloud</artifactId>
  <version>${revision}${changelist}</version>
  <packaging>hpi</packaging>

  <name>XCP-ng Cloud</name>
  <!-- Plugin description lives in src/main/resources/index.jelly, not here. -->
  <url>https://github.com/${gitHubRepo}</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>gounthar</id>
      <name>Bruno Verachten</name>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/${gitHubRepo}.git</connection>
    <developerConnection>scm:git:git@github.com:${gitHubRepo}.git</developerConnection>
    <tag>${scmTag}</tag>
    <url>https://github.com/${gitHubRepo}</url>
  </scm>

  <properties>
    <revision>0.1.0</revision>
    <changelist>-SNAPSHOT</changelist>
    <gitHubRepo>gounthar/xcpng-cloud-plugin</gitHubRepo>

    <!-- LTS baseline. 2.555.x matches what vsphere-cloud targets. -->
    <jenkins.baseline>2.555</jenkins.baseline>
    <jenkins.version>${jenkins.baseline}.3</jenkins.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.jenkins.tools.bom</groupId>
        <artifactId>bom-${jenkins.baseline}.x</artifactId>
        <version>6699.v4f03a_ff2f9c2</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>

    <!--
      cloud-stats records the lifecycle of every provisioned agent (provisioning, launching, operating,
      then completed) and surfaces it under Manage Jenkins. The plugin only has to return a
      TrackedPlannedNode and make its node and computer report the same activity id; cloud-stats' own
      listeners drive the phase transitions. The BOM manages the version.
    -->
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>cloud-stats</artifactId>
    </dependency>

    <!--
      The config model stores a credential ID and resolves the username/password at point of use.
      This is the first code that touches a secret, so the credentials plugin arrives here rather
      than at scaffold time, where every installing controller would have pulled it in for nothing.
      The BOM manages the version.
    -->
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>credentials</artifactId>
    </dependency>
    <!--
      Jackson drives the XAPI client's JSON-RPC. Jenkins core bundles jackson-databind at runtime,
      but a plugin must depend on the jackson2-api plugin to compile against it and to be pinned to
      core's version. The BOM manages the version.
    -->
    <dependency>
      <groupId>org.jenkins-ci.plugins</groupId>
      <artifactId>jackson2-api</artifactId>
    </dependency>

    <!--
      JCasC needs no runtime dependency here: the plugin is configurable purely through its
      @DataBoundConstructor/@DataBoundSetter and @Symbol annotations, which configuration-as-code
      discovers reflectively. These two are test-only, exercising the YAML import/export round-trip so a
      controller can be stood up from configuration-as-code.yaml with no click-ops. Keeping them out of
      the runtime scope leaves the plugin's install footprint unchanged for controllers that do not use
      JCasC. The BOM manages both versions.
    -->
    <dependency>
      <groupId>io.jenkins</groupId>
      <artifactId>configuration-as-code</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.jenkins.configuration-as-code</groupId>
      <artifactId>test-harness</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </pluginRepository>
  </pluginRepositories>
</project>
