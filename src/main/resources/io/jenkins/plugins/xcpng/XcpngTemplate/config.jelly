<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="${%Template name}" field="templateName">
    <f:textbox/>
  </f:entry>
  <f:entry title="${%Labels}" field="labelString">
    <f:textbox/>
  </f:entry>
  <f:entry title="${%vCPUs}" field="numCpus">
    <f:number default="2" clazz="positive-number"/>
  </f:entry>
  <f:entry title="${%Memory (MiB)}" field="memoryMb">
    <f:number default="2048" clazz="positive-number"/>
  </f:entry>
  <f:entry title="${%Warm pool size}" field="minInstances">
    <f:number default="0" min="0"/>
  </f:entry>
  <f:entry title="${%SSH authorized key (optional)}" field="sshAuthorizedKey">
    <f:textarea/>
  </f:entry>
</j:jelly>
