<?jelly escape-by-default='true'?>
<!--
  The node configuration form for an agent this cloud provisioned.

  Core's Computer/configure.jelly includes this by name, and there is no such view on Slave or
  AbstractCloudSlave, so without it the include fails: the response is already committed by then, so
  the page returns 200 and simply stops mid-render with no form on it (#179).

  What is deliberately absent matters as much as what is here.

  No launcher selector and no retention-strategy selector. Both are the cloud's to decide, neither is
  an operator's to change on a VM that is destroyed when it goes idle, and DumbSlave's version of this
  file builds its launcher dropdown from ${computerLauncherDescriptors}, the list #158 took this
  plugin's launcher out of, so including it would offer a control whose current value is missing.

  No numExecutors and no remoteFS either. Both are fixed on this agent by design.
-->
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">

  <f:entry title="${%Description}" field="nodeDescription">
    <f:textarea />
  </f:entry>

  <f:entry title="${%Labels}" field="labelString">
    <f:textbox />
  </f:entry>

  <f:descriptorList title="${%Node Properties}" field="nodeProperties"
                    descriptors="${h.getNodePropertyDescriptors(descriptor.clazz)}" />

</j:jelly>