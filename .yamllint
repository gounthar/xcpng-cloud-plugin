---
extends: default

rules:
  # 80 columns is tighter than the Java in this repo, which runs to ~110.
  line-length:
    max: 120
  # GitHub Actions requires a top-level `on:` key, which YAML 1.1 reads as the boolean
  # true. Every workflow file in the ecosystem trips this; the key is not ours to rename.
  truthy:
    check-keys: false
